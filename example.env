RAILS_ENV=production
RAILS_LOG_LEVEL=info
APP_HOST=api.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
TERMS_URL=https://app.example.com/terms
PRIVACY_URL=https://app.example.com/privacy
TERMS_VERSION=2026-08-12
PRIVACY_VERSION=2026-08-12

DATABASE_URL=postgresql://user:password@host:5432/wearo_production
DB_POOL=5
REDIS_URL=redis://host:6379/0
RAILS_MASTER_KEY=replace-me
DEVISE_JWT_SECRET_KEY=replace-with-a-separate-long-random-secret

OPENAI_API_KEY=replace-me
OPENAI_CLOTHING_MODEL=gpt-5.6-luna
OPENAI_STYLIST_MODEL=gpt-5.6-luna
OPENAI_VISUALIZATION_MODEL=gpt-image-2

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_STORAGE_BUCKET=wearo-production-private

MAILER_FROM=no-reply@example.com
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_DOMAIN=example.com

AI_DAILY_TOKEN_LIMIT=20000
AI_DAILY_REQUEST_LIMIT=30
STYLIST_DAILY_RECOMMENDATION_LIMIT=15
VISUALIZATION_DAILY_LIMIT=3
AUTO_FLAT_LAY_VISUALIZATION_DAILY_LIMIT=30
SIDEKIQ_CONCURRENCY=5
