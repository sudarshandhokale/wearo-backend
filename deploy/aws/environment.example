# Docker Compose and TLS
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
POSTGRES_PASSWORD=replace-with-url-safe-random-password
IMAGE_TAG=latest

# Rails
RAILS_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
DB_POOL=5
APP_HOST=api.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
TERMS_URL=https://app.example.com/terms
PRIVACY_URL=https://app.example.com/privacy
TERMS_VERSION=2026-08-12
PRIVACY_VERSION=2026-08-12
RAILS_MASTER_KEY=replace-me
DEVISE_JWT_SECRET_KEY=replace-with-a-separate-long-random-secret

# OpenAI
OPENAI_API_KEY=replace-me
OPENAI_CLOTHING_MODEL=gpt-5.6-luna
OPENAI_STYLIST_MODEL=gpt-5.6-luna
OPENAI_VISUALIZATION_MODEL=gpt-image-2
AI_DAILY_TOKEN_LIMIT=20000
AI_DAILY_REQUEST_LIMIT=30
STYLIST_DAILY_RECOMMENDATION_LIMIT=15
VISUALIZATION_DAILY_LIMIT=3

# S3. Prefer an EC2 instance role and leave access keys unset.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_STORAGE_BUCKET=wearo-production-private

# Amazon SES SMTP credentials are different from AWS access keys.
MAILER_FROM=no-reply@example.com
SMTP_ADDRESS=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-ses-smtp-username
SMTP_PASSWORD=replace-with-ses-smtp-password
SMTP_DOMAIN=example.com

# Keep this low on a single EC2 preview instance.
SIDEKIQ_CONCURRENCY=2
